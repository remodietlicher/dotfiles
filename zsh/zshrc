# Shared zsh config, tracked in this repo.
#
# Unlike ghostty/ and nvim/, this is NOT symlinked over ~/.zshrc — it is SOURCED
# from it by a single line near the bottom of ~/.zshrc:
#
#   [[ -f ~/code/dotfiles/zsh/zshrc ]] && source ~/code/dotfiles/zsh/zshrc
#
# Sourcing rather than symlinking, for two reasons. Installers (brew, rustup,
# uv, conda, …) append their init lines to ~/.zshrc; if that path were a symlink
# into here, those writes would land in this repo — which is public, and that is
# how a token eventually gets committed. And ~/.zshrc stays the machine's own
# file, so a second machine can differ without needing a branch.
#
# So: everything portable goes here; everything machine-specific or secret goes
# in ~/.zshrc.local, sourced at the bottom and never committed.

# ---------------------------------------------------------------------------
# fzf
# ---------------------------------------------------------------------------
# ALT-C (left-Option+C — ghostty sets `macos-option-as-alt = left`) cds into a
# subdirectory; CTRL-T pastes a path. Left alone, fzf's built-in walker runs
# with `hidden`, so in ~ the list is mostly dotdirs and Library. Pointing the
# widgets at fd fixes that: fd skips hidden entries by default and honors
# .gitignore. Both need fd on PATH (`brew install fd`).
export FZF_ALT_C_COMMAND='fd --type d --exclude Library --exclude node_modules'
export FZF_CTRL_T_COMMAND='fd --hidden=false --exclude Library'

# ---------------------------------------------------------------------------
# kubectl
# ---------------------------------------------------------------------------
# One kubeconfig per cluster in ~/.kube/configs/, joined into KUBECONFIG so
# kubectl, kubectx and kubens see all contexts. ~/.kube/config goes first: it
# holds current-context, and `kubectl config use-context` writes to the first
# file. Left alone if KUBECONFIG is already set, so a shell started with a
# restricted config (e.g. Claude Code's) keeps it.
() {
  [[ -n $KUBECONFIG ]] && return
  local files=($HOME/.kube/config(N.) $HOME/.kube/configs/*(N.))
  (( $#files )) && export KUBECONFIG=${(j.:.)files}
}

# ---------------------------------------------------------------------------
# GitHub Actions
# ---------------------------------------------------------------------------
# gha lists the workflow runs that haven't finished yet (queued or in progress)
# for the repo you're in; gh resolves the repo from the git remote, so any
# subdirectory works. Extra args go to `gh run list`, e.g. `gha -b main` or
# `gha -w ci.yml`.
gha() {
  gh run list -L 50 "$@" \
    --json status,workflowName,headBranch,event,createdAt,databaseId \
    --template '{{$n := 0}}{{range .}}{{if ne .status "completed"}}{{$n = 1}}{{tablerow .status .workflowName .headBranch .event (timeago .createdAt) .databaseId}}{{end}}{{end}}{{if not $n}}No running workflow runs.{{"\n"}}{{end}}'
}

# ghaw re-runs gha every 10 s (`-n SECS` to change) as a dashboard to leave
# open in a tab; Ctrl-C stops it. Other args go to gha. The output is captured
# before clearing so the screen doesn't sit blank while gh waits on the API;
# GH_FORCE_TTY keeps gh's aligned table even though stdout is a pipe.
ghaw() {
  local -a interval=(-n 10)
  zparseopts -D -E -K n:=interval
  local out
  while true; do
    out=$(GH_FORCE_TTY=$COLUMNS gha "$@" 2>&1)
    clear
    print -r -- "$(date +%H:%M:%S) · every ${interval[-1]}s · Ctrl-C to stop"$'\n'
    print -r -- $out
    sleep ${interval[-1]}
  done
}

# ---------------------------------------------------------------------------
# Copy the last command and its output (herdr)
# ---------------------------------------------------------------------------
# cpl puts the previous command plus what it printed on the clipboard as
#
#   $ <command>
#   <output>
#
# without running it again: the output comes from the pane's scrollback via
# `herdr pane read`. herdr has no prompt marks, so cpl finds the command by its
# text: from the bottom up, the first line that ends in it (after a space, i.e.
# after the prompt) starts the output, and the prompt cpl was typed at ends it.
# Breaks if a right prompt (RPROMPT) stays on the command line, or if the
# output itself has a line ending in " <command>".
cpl() {
  emulate -L zsh -o extendedglob
  if [[ -z $HERDR_PANE_ID ]]; then
    print -u2 "cpl: not in a herdr pane"
    return 1
  fi
  local cmd=${history[$((HISTCMD-1))]}
  local last=${cmd##*$'\n'}
  local -a lines
  lines=("${(@f)$(herdr pane read $HERDR_PANE_ID --source recent-unwrapped --lines 5000)}") || return
  lines=("${(@)lines%%[[:space:]]#}")
  # The bottom row (after blank ones) is the line cpl was typed on; a
  # multi-line prompt takes the rows above it too.
  local end=$#lines
  while (( end > 0 )) && [[ -z $lines[end] ]]; do (( end-- )); done
  (( end -= ${#${(%)PS1}//[^$'\n']} ))
  local start
  for (( start = end - 1; start > 0; start-- )); do
    [[ $lines[start] == *[[:space:]]"$last" ]] && break
  done
  if (( start < 1 )); then
    print -u2 "cpl: can't find \`$last' in the scrollback"
    return 1
  fi
  local out=${(F)lines[start+1,end-1]}
  out=${out%%$'\n'#}
  print -r -- "\$ $cmd"${out:+$'\n'$out} | pbcopy
  print -u2 "cpl: copied \`$last' and its output"
}

# ---------------------------------------------------------------------------
# Machine-local overrides — deliberately last, so it can override anything
# above. This is the un-committed file the LiteLLM section of CLAUDE.md refers
# to: LITELLM_BASE_URL / LITELLM_API_KEY belong there, not here.
# ---------------------------------------------------------------------------
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
