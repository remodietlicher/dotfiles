# ~/.config/ghostty/config
# Ghostty as a single, dumb terminal — tmux handles all multiplexing.
# Reference: `ghostty +show-config --default --docs` lists every option.

# ─────────────────────────────────────────────────────────────────────────────
# Font
# ─────────────────────────────────────────────────────────────────────────────
font-family = "FiraCode Nerd Font"
font-size = 12
font-thicken = true

# ─────────────────────────────────────────────────────────────────────────────
# Theme / appearance
# ─────────────────────────────────────────────────────────────────────────────
theme = "Catppuccin Mocha"
background-opacity = 1.0
cursor-style = block
cursor-style-blink = false
window-padding-x = 8
window-padding-y = 8

# Don't show the macOS titlebar tabs / keep it clean
macos-titlebar-style = tabs
window-theme = auto

# ─────────────────────────────────────────────────────────────────────────────
# Behavior
# ─────────────────────────────────────────────────────────────────────────────
# Open new windows/tabs in the working directory (matters only if you use them)
window-inherit-working-directory = true
# Confirm before closing a surface that has a running process
confirm-close-surface = true
# Scrollback handled mostly by tmux, but keep a healthy local buffer too
scrollback-limit = 10000
# Only the RIGHT Option key acts as Alt/Meta (for Alt-based shortcuts like fzf's
# Alt-C and Option+Delete in nvim). The RIGHT Option key stays normal so the
# Swiss/German layout can still type ~ @ [ ] { } | \ etc. (all Option+key combos).
macos-option-as-alt = left
# Don't let the shell integration auto-inject features that fight tmux
shell-integration = detect

# ─────────────────────────────────────────────────────────────────────────────
# Hand multiplexing entirely to tmux — unbind Ghostty's own splits/tabs/nav
# so they never shadow tmux or get fat-fingered.
# ─────────────────────────────────────────────────────────────────────────────
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+t=unbind
keybind = cmd+shift+enter=unbind
keybind = cmd+left_bracket=unbind
keybind = cmd+right_bracket=unbind
keybind = cmd+alt+left=unbind
keybind = cmd+alt+right=unbind
keybind = cmd+alt+up=unbind
keybind = cmd+alt+down=unbind
keybind = cmd+shift+left_bracket=unbind
keybind = cmd+shift+right_bracket=unbind

# Keep the genuinely useful, non-conflicting ones:
#   cmd+n  new window      cmd+q  quit
#   cmd+c / cmd+v  copy/paste   cmd+plus / cmd+minus / cmd+0  font size

# cmd+j / cmd+k -> next / previous herdr space (j = down the sidebar). Sent as
# kitty-protocol Super+j/k (ESC [ 106|107 ; 9 u) like cmd+h/l below, and bound
# as cmd+j/k in herdr/config.toml. Replaces Ghostty's cmd+k (clear scrollback);
# pane zoom stays on prefix + z.
keybind = cmd+j=text:\x1b[106;9u
keybind = cmd+k=text:\x1b[107;9u

# cmd+shift+j / cmd+shift+k -> next / previous herdr agent, the same keys as
# spaces with shift added. Kitty-protocol Super+Shift+j/k: modifier 10 =
# 1 + shift 1 + super 8; bound as cmd+shift+j/k in herdr/config.toml.
# Replaces Ghostty's cmd+shift+j (write the screen to a file and paste its path).
keybind = cmd+shift+j=text:\x1b[106;10u
keybind = cmd+shift+k=text:\x1b[107;10u

# cmd+left / cmd+right -> nvim jumplist "go back" / "go forward".
# Ghostty can't tell it's nvim, so it just forwards the raw control bytes that
# nvim reads as <C-o> / <C-i>:  Ctrl-O = \x0f (back),  Ctrl-I = \x09 (forward,
# same byte as Tab). They travel through tmux untouched (prefix is Ctrl-Space).
keybind = cmd+left=text:\x0f
keybind = cmd+right=text:\x09

# cmd+w -> close the current nvim buffer (the macOS "close tab" muscle memory).
# Ghostty can't see Cmd, so translate it into the kitty-protocol encoding for
# Super+w:  ESC [ 119 ; 9 u  (119 = 'w', modifier 9 = super). nvim decodes this
# as <D-w> and maps it to Snacks.bufdelete (see nvim/lua/config/keymaps.lua).
# The bytes pass through tmux untouched (no Ctrl-Space prefix involved).
keybind = cmd+w=text:\x1b[119;9u

# cmd+h / cmd+l -> previous / next herdr tab in one stroke. Sent as kitty-protocol
# Super+h/l (ESC [ 104|108 ; 9 u) like cmd+w, and bound as cmd+h/l in
# herdr/config.toml. A raw \x00 prefix sequence (the cmd+j trick) doesn't
# register in herdr. Takes over macOS's cmd+h (Hide Ghostty).
keybind = cmd+h=text:\x1b[104;9u
keybind = cmd+l=text:\x1b[108;9u

# cmd+1..9 -> herdr tab 1..9. Sent as kitty-protocol Super+digit
# (ESC [ 49..57 ; 9 u, the digit's ASCII code) like cmd+h/l, and bound as
# cmd+1..9 (switch_tab) in herdr/config.toml. Replaces Ghostty's own goto_tab,
# which has nothing to do here since herdr owns the tabs. Bound by physical
# key (digit_N): Ghostty's defaults are bound that way too, and a physical-key
# binding beats a plain `cmd+2`, so the plain form never fires.
keybind = cmd+digit_1=text:\x1b[49;9u
keybind = cmd+digit_2=text:\x1b[50;9u
keybind = cmd+digit_3=text:\x1b[51;9u
keybind = cmd+digit_4=text:\x1b[52;9u
keybind = cmd+digit_5=text:\x1b[53;9u
keybind = cmd+digit_6=text:\x1b[54;9u
keybind = cmd+digit_7=text:\x1b[55;9u
keybind = cmd+digit_8=text:\x1b[56;9u
keybind = cmd+digit_9=text:\x1b[57;9u

# option+backspace -> delete the word before the cursor. Sends Ctrl-W (\x17),
# which zsh, nvim insert mode and most TUIs treat as backward-kill-word, rather
# than the ESC+DEL that Alt+Backspace produces and not every app decodes.
keybind = alt+backspace=text:\x17
